# Server-only settings for the Next.js app. Copy to .env.local and fill in.
# Browsers never call the API directly: Next.js forwards signed-in calls (AUTH-03).
CAISSA_API_URL=http://127.0.0.1:8000
# Same long random value as INTERNAL_TOKEN in the repo .env.
CAISSA_INTERNAL_TOKEN=
# Optional: proof-of-work difficulty for the invisible bot check (AUTH-05). Default 14.
# CAISSA_BOT_CHECK_BITS=14
NEXTAUTH_URL=http://localhost:3000
# Long random value, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# OAuth apps: GitHub callback http://localhost:3000/api/auth/callback/github,
# Google callback http://localhost:3000/api/auth/callback/google. An empty id hides that button.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
